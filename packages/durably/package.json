{
  "name": "@coji/durably",
  "version": "0.17.0",
  "description": "Step-oriented resumable batch execution for Node.js and browsers using SQLite",
  "keywords": [
    "batch",
    "durable",
    "job",
    "kysely",
    "queue",
    "resumable",
    "sqlite",
    "workflow"
  ],
  "homepage": "https://github.com/coji/durably#readme",
  "bugs": {
    "url": "https://github.com/coji/durably/issues"
  },
  "license": "MIT",
  "author": "coji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coji/durably.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm test:node && pnpm test:react && pnpm test:browser",
    "test:node": "vitest run --config vitest.config.ts",
    "test:react": "vitest run --config vitest.react.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "compression": "^1.8.2",
    "jsdom": "^31.0.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlocal": "^0.18.0",
    "testcontainers": "12.2.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "kysely": "^0.27.0 || ^0.28.0 || ^0.29.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
