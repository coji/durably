{
  "name": "@coji/durably-react",
  "version": "0.16.1",
  "description": "React bindings for Durably - step-oriented resumable batch execution",
  "keywords": [
    "batch",
    "durable",
    "durably",
    "hooks",
    "job",
    "queue",
    "react",
    "workflow"
  ],
  "homepage": "https://github.com/coji/durably#readme",
  "bugs": {
    "url": "https://github.com/coji/durably/issues"
  },
  "license": "MIT",
  "author": "coji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coji/durably.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spa": {
      "types": "./dist/spa.d.ts",
      "import": "./dist/spa.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm test:react",
    "test:react": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "devDependencies": {
    "@coji/durably": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "kysely": "^0.29.6",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlocal": "^0.18.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@coji/durably": "^0.16.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@coji/durably": {
      "optional": true
    }
  }
}
