{
  "name": "durably-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:node": "turbo run test:node --filter=@coji/durably",
    "test:browser": "turbo run test:browser --filter=@coji/durably",
    "test:react": "turbo run test:react --filter=@coji/durably",
    "dev:node": "turbo run dev --filter=example-node",
    "dev:browser": "turbo run dev --filter=example-browser",
    "dev:react": "turbo run dev --filter=example-react",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "turbo run format",
    "format:fix": "pnpm -r format:fix",
    "validate": "node scripts/check-test-sleeps.mjs && turbo run format lint typecheck test && pnpm smoke:react-examples && pnpm doctor:check && pnpm test:security-scan",
    "smoke:react-examples": "node scripts/check-react-example-imports.mjs",
    "doctor": "react-doctor --scope full",
    "doctor:check": "node scripts/check-react-doctor.mjs",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "deps:outdated": "pnpm outdated -r --include-github-actions",
    "deps:update:actions": "pnpm update --include-github-actions \"actions/*\" pnpm/setup",
    "security:scan:setup": "node scripts/shannon-fullstack-audit.mjs setup",
    "security:scan:validate": "node scripts/shannon-fullstack-audit.mjs validate",
    "security:scan:fullstack": "node scripts/shannon-fullstack-audit.mjs run",
    "security:scan:status": "node scripts/shannon-fullstack-audit.mjs status",
    "security:scan:down": "node scripts/shannon-fullstack-audit.mjs down",
    "test:security-scan": "oxfmt --check scripts/shannon-fullstack-audit.mjs scripts/shannon-fullstack-audit.test.mjs && node --test scripts/shannon-fullstack-audit.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "react-doctor": "0.9.22",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  }
}
