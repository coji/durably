  "dependencies": {
    "@coji/durably": "workspace:*",
    "@coji/durably-react": "workspace:*",
    "@libsql/kysely-libsql": "^0.4.1",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@vercel/react-router": "^1.3.7",
    "isbot": "^5.2.2",
    "kysely": "^0.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tailwindcss": "^4.3.5",
